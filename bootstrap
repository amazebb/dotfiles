#!/usr/bin/env bash
# shellcheck disable=SC2016
# bootstrap - Safe bare repo dotfiles installer

set -euo pipefail

U() { printf '\e[4m%s\e[0m' "$*"; }

B() { printf '\e[1m%s\e[0m' "$*"; }

I() { printf '\e[3m%s\e[0m' "$*"; }

Q() {
    read -r -p "$1 [y/n]: "
    if [[ ! $REPLY =~ [Yy] ]]; then
        echo "Aborted."
        exit 1
    fi
}

ask() {
    read -r -p "$1: "
    echo "$REPLY"
}

color() {
    local name=$1; shift
    local code
    case $name in
        RED)     code=31 ;;
        GREEN)   code=32 ;;
        YELLOW)  code=33 ;;
        BLUE)    code=34 ;;
        MAGENTA) code=35 ;;
        CYAN)    code=36 ;;
        *)       code=0  ;;
    esac
    printf '\e[%sm%s\e[0m' "$code" "$*"
}

msg() { printf '%s\n' "$(color "$2" "$1")" >&2; }

info() { msg "$1" BLUE; }

warn() { msg "$1" RED; exit 1; }

argval() {
    (($# < 2)) || [[ $2 = -* ]] && warn "Error: $1 requires a valid argument" || echo "$2"
    # NOTE Because 'warn' is called in a sub-shell, the exit 1 does not
    # exit immediately. The parse arguments while loop will cycle
    # through all entered args.
}

noargs() { if ((!$1)); then info "Error: no arguments provided"; usage; exit 1; fi; }

usage() {
    cat <<EOF
$(B NAME)
    $(B bootstrap) - Safe bare repo dotfiles installer

$(B SYNOPSIS)
    $(B "bootstrap [-h] [-n] [-v] [-f] [-d dir]") $(U repo)

$(B DESCRIPTION)
    Clone a bare dotfiles repository and check out tracked files into \$HOME.
    By default runs in dry-run mode: clones to a temp directory, shows
    conflicts and diffs, then exits without modifying \$HOME.

$(B OPTIONS)
    $(B -h)         Show this help message

    $(B -n)         Dry-run: clone to a temp directory, show conflicts/diffs,
               then exit without modifying \$HOME $(I '(default)')

    $(B -v)         Show diffs of changes that would be made

    $(B -f)         Override dry-run mode and check out files

    $(B -d) $(U dir)     Dotfiles repo folder $(I '(default: $HOME/.dotfiles)')

$(B ARGUMENTS)
    $(U repo)        Repo URL to clone from $(I required)

$(B EXAMPLES)
    Dry-run preview from a remote repo

        bootstrap git@github.com:user/dotfiles.git

    Apply changes after reviewing the dry-run

        bootstrap -f git@github.com:user/dotfiles.git

EOF
}

DOTFILES_DIR="$HOME/.dotfiles"
REPO_URL=""
DRY_RUN=true
TMPDIR=""
VERBOSE=false

cleanup() {
    local exit_code=$?
    if [[ -n "$TMPDIR" && -d "$TMPDIR" ]]; then
        rm -rf "$TMPDIR"
    fi
    exit "$exit_code"
}

noargs $#

# --- 1. Parse flags ---
while (($#)); do
    case "$1" in
    -n) DRY_RUN=true ;;
    -v) VERBOSE=true ;;
    -f) DRY_RUN=false ;;
    -h) usage && exit 0 ;;
    -d)
        DOTFILES_DIR=$(argval "$@")
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)  warn "Unknown option: $1" ;;
    *)   REPO_URL=$1 ;;
    esac
    shift
done

[[ -z $REPO_URL ]] && usage && warn "repo argument is required"

# --- 2. Pre-flight checks ---
command -v git >/dev/null 2>&1 || warn "git is not installed"

if ! $DRY_RUN && [[ -e "$DOTFILES_DIR" ]]; then
    warn "$DOTFILES_DIR already exists; remove it first or use a different path"
fi

# --- 3. Clone to a temp directory ---
TMPDIR=$(mktemp -d)
trap cleanup EXIT

$DRY_RUN && info "Dry-run, no changes will be made:"
info "Cloning from $REPO_URL"
git clone --bare "$REPO_URL" "$TMPDIR/repo" || warn "git clone failed"

# Helper: run git against the temp bare repo with $HOME as work tree
_git() {
    git --git-dir="$TMPDIR/repo" "$@"
}

# --- 4. Compare tracked files against $HOME ---
FILES=$(_git ls-tree -r --name-only HEAD 2>/dev/null)

[[ -z "$FILES" ]] && warn "No files found in repo"

CONFLICTS=()
EXISTING=()
NEW=()
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    if [[ -e "$HOME/$file" || -L "$HOME/$file" ]]; then
        EXISTING+=("$file")
        if ! diff -q "$HOME/$file" <(_git show "HEAD:$file") >/dev/null 2>&1; then
            CONFLICTS+=("$file")
        fi
    else
        NEW+=("$file")
    fi
    echo "$file"
done <<<"$FILES"

Q "Are the above dotfiles what you expect?"

# --- 5. Show diffs and prompt ---
if $VERBOSE; then
    if ((${#CONFLICTS[@]})); then
        if command -v opendiff >/dev/null 2>&1 && xcode-select -p 2>/dev/null | grep -q "Xcode.app"; then
            HOME_VIEW="$TMPDIR/home-view"
            REPO_VIEW="$TMPDIR/repo-view"
            for file in "${CONFLICTS[@]}"; do
                mkdir -p "$HOME_VIEW/$(dirname "$file")"
                mkdir -p "$REPO_VIEW/$(dirname "$file")"
                cp "$HOME/$file" "$HOME_VIEW/$file"
                _git show "HEAD:$file" > "$REPO_VIEW/$file"
            done
            info "Opening FileMerge (current <- repo)... close it when done reviewing."
            opendiff "$HOME_VIEW" "$REPO_VIEW" &>/dev/null &
            sleep 1
            while pgrep -xq "FileMerge" 2>/dev/null; do sleep 1; done
        else
            echo ""
            info "Diffs (existing <- repo):"
            for file in "${CONFLICTS[@]}"; do
                echo "--- $file ---"
                diff "$HOME/$file" <(_git show "HEAD:$file") || true
                echo ""
            done
        fi
    else
        info "No diffs, all existing files are identical."
    fi
fi

if ((${#NEW[@]})); then
    echo ""
    info "New files (${#NEW[@]}):"
    for file in "${NEW[@]}"; do
        printf '  %s\n' "$file"
    done
fi

if ((${#CONFLICTS[@]})); then
    echo ""
    info "Conflicting files (${#CONFLICTS[@]}):"
    for file in "${CONFLICTS[@]}"; do
        printf '  %s\n' "$file"
    done
    echo ""

    if $DRY_RUN; then
        info "Dry-run finished"
        exit 0
    fi

    Q "Backup these files and proceed?"
else
    if $DRY_RUN; then
        info "Dry-run finished"
        exit 0
    fi
fi

# --- 6. Backup all existing files so checkout succeeds ---
if ((${#EXISTING[@]})); then
    BACKUP_DIR="$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$BACKUP_DIR"
    for file in "${EXISTING[@]}"; do
        mkdir -p "$BACKUP_DIR/$(dirname "$file")"
        mv "$HOME/$file" "$BACKUP_DIR/$file"
    done
    info "Backed up ${#EXISTING[@]} file(s) to $BACKUP_DIR"
    echo ""
fi

# --- 7. Move bare repo and checkout ---
mv "$TMPDIR/repo" "$DOTFILES_DIR"
TMPDIR="" # nothing left to clean up

dotfiles() {
    git --git-dir="$DOTFILES_DIR" --work-tree="$HOME" "$@"
}

dotfiles config --local status.showUntrackedFiles no

info "The following files will be checked out to $HOME:"
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    printf '  %s\n' "$file"
done <<<"$(dotfiles ls-tree -r --name-only HEAD)"
echo ""

Q "Proceed with checkout?"

info "Checking out dotfiles..."
if dotfiles checkout; then
    info "Dotfiles installed successfully."
else
    msg "Checkout failed." RED
    if [[ -n "${BACKUP_DIR:-}" ]]; then
        msg "Your original files are in $BACKUP_DIR" RED
    fi
    exit 1
fi
