#!/usr/bin/env bash
# shellcheck disable=SC2016
# bootstrap - Safe bare repo dotfiles installer

set -euo pipefail

U() { printf '\e[4m%s\e[0m' "$*"; }

B() { printf '\e[1m%s\e[0m' "$*"; }

I() { printf '\e[3m%s\e[0m' "$*"; }

Q() {
    local reply=""
    read -r -p "$1 [y/n]: " reply || true # EOF (no tty) leaves reply empty: treated as no
    if [[ ! $reply =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 1
    fi
}

color() {
    local name=$1; shift
    local code
    case $name in
        RED)     code=31 ;;
        GREEN)   code=32 ;;
        YELLOW)  code=33 ;;
        BLUE)    code=34 ;;
        MAGENTA) code=35 ;;
        CYAN)    code=36 ;;
        *)       code=0  ;;
    esac
    printf '\e[%sm%s\e[0m' "$code" "$*"
}

msg() { printf '%s\n' "$(color "$2" "$1")" >&2; }

info() { msg "$1" BLUE; }

warn() { msg "$1" RED; exit 1; }

argval() {
    (($# < 2)) || [[ $2 = -* ]] && warn "Error: $1 requires a valid argument" || echo "$2"
    # NOTE 'warn' runs in the caller's $(...) subshell and exits only that
    # subshell; the failed assignment then trips set -e and stops the script.
}

# Print why $HOME/$1 cannot be written safely and return 0, or return 1 if it can:
# a parent that is a symlink (mv would follow it) or exists but is not a directory
parent_problem() {
    local path=$HOME dir
    local -a parts
    IFS=/ read -ra parts <<<"$(dirname -- "$1")"
    for dir in "${parts[@]}"; do
        [[ $dir == . ]] && continue
        path+="/$dir"
        if [[ -L $path ]]; then
            echo "a symlink"
            return 0
        fi
        if [[ -e $path && ! -d $path ]]; then
            echo "not a directory"
            return 0
        fi
    done
    return 1
}

# True if a repo path could escape $HOME or touch git metadata:
# absolute, or has a ., .. or .git component (any case)
unsafe_path() {
    case $1 in
    /*) return 0 ;;
    esac
    case /$1/ in
    */./* | */../* | */.[Gg][Ii][Tt]/*) return 0 ;;
    esac
    return 1
}

# Move every file in MOVED back from BACKUP_DIR to $HOME; return 1 if any could not be restored
rollback_backup() {
    local f failed=0
    if ((${#MOVED[@]})); then
        for f in "${MOVED[@]}"; do
            if ! mv "$BACKUP_DIR/$f" "$HOME/$f"; then
                msg "Could not restore $(printf '%q' "$f"); it is in $BACKUP_DIR" RED
                failed=1
            fi
        done
    fi
    if [[ -n $BACKUP_DIR ]]; then
        find "$BACKUP_DIR" -depth -type d -empty -delete 2>/dev/null || true
    fi
    return "$failed"
}

# Exactly one repo operand is allowed
setrepo() {
    [[ -z $REPO_URL ]] || warn "Error: only one repo may be given ($REPO_URL, $1)"
    REPO_URL=$1
}

noargs() { if ((!$1)); then info "Error: no arguments provided"; usage; exit 1; fi; }

usage() {
    cat <<EOF
$(B NAME)
    $(B bootstrap) - Safe bare repo dotfiles installer

$(B SYNOPSIS)
    $(B "bootstrap [-h] [-n] [-v] [-f] [-d dir]") $(U repo)

$(B DESCRIPTION)
    Clone a bare dotfiles repository and check out tracked files into \$HOME.
    By default runs in dry-run mode: clones to a temp directory, shows
    conflicts and diffs, then exits without modifying \$HOME.

$(B OPTIONS)
    $(B -h)         Show this help message

    $(B -n)         Dry-run: clone to a temp directory, show conflicts/diffs,
               then exit without modifying \$HOME $(I '(default)')

    $(B -v)         Show diffs of changes and contents of new files

    $(B -f)         Override dry-run mode and check out files

    $(B -d) $(U dir)     Dotfiles repo folder $(I '(default: $HOME/.dotfiles)')

$(B ARGUMENTS)
    $(U repo)        Repo URL to clone from $(I required)

$(B EXAMPLES)
    Dry-run preview from a remote repo

        bootstrap git@github.com:user/dotfiles.git

    Apply changes after reviewing the dry-run

        bootstrap -f git@github.com:user/dotfiles.git

EOF
}

DOTFILES_DIR="$HOME/.dotfiles"
REPO_URL=""
DRY_RUN=true
WORK=""
VERBOSE=false
BACKUP_DIR=""
MOVED=()

cleanup() {
    local exit_code=$?
    if [[ -n "$WORK" && -d "$WORK" ]]; then
        rm -rf "$WORK"
    fi
    exit "$exit_code"
}

noargs $#

# --- 1. Parse flags ---
while (($#)); do
    case "$1" in
    -n) DRY_RUN=true ;;
    -v) VERBOSE=true ;;
    -f) DRY_RUN=false ;;
    -h) usage && exit 0 ;;
    -d)
        DOTFILES_DIR=$(argval "$@")
        shift
        ;;
    --)
        shift
        while (($#)); do
            setrepo "$1"
            shift
        done
        break
        ;;
    -*)  warn "Unknown option: $1" ;;
    *)   setrepo "$1" ;;
    esac
    shift
done

[[ -z $REPO_URL ]] && usage && warn "repo argument is required"

# --- 2. Pre-flight checks ---
command -v git >/dev/null 2>&1 || warn "git is not installed"

if ! $DRY_RUN && [[ -e "$DOTFILES_DIR" ]]; then
    warn "$DOTFILES_DIR already exists; remove it first or use a different path"
fi

if ! $DRY_RUN && [[ ! -d "$(dirname -- "$DOTFILES_DIR")" ]]; then
    warn "$(dirname -- "$DOTFILES_DIR") does not exist; create it first or use a different path"
fi

# --- 3. Clone to a temp directory ---
WORK=$(mktemp -d)
trap cleanup EXIT

$DRY_RUN && info "Dry-run, no changes will be made:"
info "Cloning from $REPO_URL"
# https, ssh (incl. user@host:path) and local paths only: no http://, git:// or ext::
git clone --bare -c transfer.fsckObjects=true \
    -c protocol.allow=never -c protocol.https.allow=always \
    -c protocol.ssh.allow=always -c protocol.file.allow=always \
    -- "$REPO_URL" "$WORK/repo" || warn "git clone failed"

# Helper: run git against the temp bare repo with $HOME as work tree
_git() {
    git --git-dir="$WORK/repo" "$@"
}

# --- 4. Compare tracked files against $HOME ---
CONFLICTS=()
EXISTING=()
NEW=()
# NUL-delimited so names with newlines/odd characters can't corrupt the lists
while IFS= read -r -d '' file; do
    [[ -z "$file" ]] && continue
    if unsafe_path "$file"; then
        warn "Refusing: unsafe path in repo: $(printf '%q' "$file")"
    fi
    if reason=$(parent_problem "$file"); then
        warn "Refusing: parent of \$HOME/$(printf '%q' "$file") is $reason"
    fi
    if [[ -e "$HOME/$file" || -L "$HOME/$file" ]]; then
        EXISTING+=("$file")
        if ! diff -q "$HOME/$file" <(_git show "HEAD:$file") >/dev/null 2>&1; then
            CONFLICTS+=("$file")
        fi
    else
        NEW+=("$file")
    fi
    printf '%q\n' "$file"
done < <(_git ls-tree -r -z --name-only HEAD 2>/dev/null)

((${#EXISTING[@]} + ${#NEW[@]})) || warn "No files found in repo"

info "These files will run as your user (shell rc, etc.). Only proceed with repos you trust."
$VERBOSE || info "Use -v to review diffs and new file contents first."

# --- 5. Show diffs and new file contents, then confirm ---
if $VERBOSE; then
    if ((${#CONFLICTS[@]})); then
        if command -v opendiff >/dev/null 2>&1 && xcode-select -p 2>/dev/null | grep -q "Xcode.app"; then
            HOME_VIEW="$WORK/home-view"
            REPO_VIEW="$WORK/repo-view"
            for file in "${CONFLICTS[@]}"; do
                mkdir -p "$HOME_VIEW/$(dirname -- "$file")"
                mkdir -p "$REPO_VIEW/$(dirname -- "$file")"
                cp -RP "$HOME/$file" "$HOME_VIEW/$file"
                _git show "HEAD:$file" > "$REPO_VIEW/$file"
            done
            info "Opening FileMerge (current <- repo)... close it when done reviewing."
            opendiff "$HOME_VIEW" "$REPO_VIEW" &>/dev/null &
            sleep 1
            while pgrep -xq "FileMerge" 2>/dev/null; do sleep 1; done
        elif command -v vimdiff >/dev/null 2>&1; then
            for file in "${CONFLICTS[@]}"; do
                REPO_TMP="$WORK/vimdiff-$(echo "$file" | tr '/' '-')"
                _git show "HEAD:$file" > "$REPO_TMP"
                vimdiff "$HOME/$file" "$REPO_TMP"
            done
        else
            echo ""
            info "Diffs (existing <- repo):"
            for file in "${CONFLICTS[@]}"; do
                echo "--- $(printf '%q' "$file") ---"
                diff "$HOME/$file" <(_git show "HEAD:$file") | cat -v || true
                echo ""
            done
        fi
    else
        info "No diffs, all existing files are identical."
    fi

    if ((${#NEW[@]})); then
        for file in "${NEW[@]}"; do
            echo "--- new: $(printf '%q' "$file") ---"
            _git show "HEAD:$file" | cat -v
            echo ""
        done
    fi
fi

Q "Are the above dotfiles what you expect?"

if ((${#NEW[@]})); then
    echo ""
    info "New files (${#NEW[@]}):"
    for file in "${NEW[@]}"; do
        printf '  %q\n' "$file"
    done
fi

if ((${#CONFLICTS[@]})); then
    echo ""
    info "Conflicting files (${#CONFLICTS[@]}):"
    for file in "${CONFLICTS[@]}"; do
        printf '  %q\n' "$file"
    done
    echo ""

    if $DRY_RUN; then
        info "Dry-run finished"
        exit 0
    fi

    Q "Backup these files and proceed?"
else
    if $DRY_RUN; then
        info "Dry-run finished"
        exit 0
    fi
fi

info "The following files will be checked out to $HOME:"
while IFS= read -r -d '' file; do
    printf '  %q\n' "$file"
done < <(_git ls-tree -r -z --name-only HEAD)
echo ""

Q "Proceed with checkout?"

# --- 6. Backup all existing files so checkout succeeds ---
if ((${#EXISTING[@]})); then
    # mktemp creates it 0700 and unique, so a rerun in the same second cannot reuse or overwrite a backup
    BACKUP_DIR=$(mktemp -d "$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S).XXXXXX")
    for file in "${EXISTING[@]}"; do
        if mkdir -p "$BACKUP_DIR/$(dirname -- "$file")" && mv "$HOME/$file" "$BACKUP_DIR/$file"; then
            MOVED+=("$file")
        else
            msg "Backup of $(printf '%q' "$file") failed; restoring the files already moved." RED
            rollback_backup || warn "Some files could not be restored, see above."
            warn "Nothing was changed."
        fi
    done
    info "Backed up ${#EXISTING[@]} file(s) to $BACKUP_DIR"
    echo ""
fi

# --- 7. Move bare repo and checkout ---
if ! mv "$WORK/repo" "$DOTFILES_DIR"; then
    msg "Could not move the repo to $DOTFILES_DIR." RED
    rollback_backup || warn "Some files could not be restored, see above."
    warn "Nothing was changed."
fi
WORK="" # nothing left to clean up

dotfiles() {
    git --git-dir="$DOTFILES_DIR" --work-tree="$HOME" "$@"
}

dotfiles config --local status.showUntrackedFiles no

info "Checking out dotfiles..."
if dotfiles checkout; then
    info "Dotfiles installed successfully."
else
    msg "Checkout failed." RED
    if [[ -n "${BACKUP_DIR:-}" ]]; then
        msg "Your original files are in $BACKUP_DIR" RED
    fi
    exit 1
fi
