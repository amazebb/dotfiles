#!/usr/bin/env bash
# bootstrap - Safe bare repo dotfiles installer

set -euo pipefail

DOTFILES_DIR="$HOME/.dotfiles"
REPO_URL=""
DRY_RUN=true
TMPDIR=""
VERBOSE=false

usage() {
    cat <<'EOF'
Usage: bootstrap [-n | --dry-run] [-h | --help] [-d | --dir] [-r | --repo]

Clone a bare dotfiles repository and check out tracked files into $HOME.

Options:
  -h, --help    Show this help message
  -n, --dry-run Clone to a temp directory, show conflicts/diffs, then exit
                without modifying $HOME
  -v, --verbose Show diffs of changes that would be made              
  -f, --force   Overwrite --dry-run mode if you are sure and checkout files              
  -d, --dir     Dotfiles repo folder, default: $HOME/.dotfiles
  -r, --repo    Repo to clone from
EOF
    exit 0
}

cleanup() {
    if [[ -n "$TMPDIR" && -d "$TMPDIR" ]]; then
        rm -rf "$TMPDIR"
    fi
    exit 0
}

die() {
    echo "error: $1" >&2
    exit 1
}

((!$#)) && usage

# --- 1. Parse flags ---
while (($#)); do
    case "$1" in
    -n | --dry-run) DRY_RUN=true ;;
    -v | --verbose) VERBOSE=true ;;
    -f | --force) DRY_RUN=false ;;
    -h | --help) usage ;;
    -d | --dir)
        [[ -z ${2:-} ]] && die "-d|--dir requires an argument"
        DOTFILES_DIR=$2
        shift
        ;;
    -r | --repo)
        [[ -z ${2:-} ]] && die "-r|--repo requires an argument"
        REPO_URL=$2
        shift
        ;;
    --)
        shift
        break
        ;;
    *) die "unknown option: $1" ;;
    esac
    shift
done

[[ -z $REPO_URL ]] && printf "%s\n\n" "--repo URL can not be empty" && usage

# --- 2. Pre-flight checks ---
command -v git >/dev/null 2>&1 || die "git is not installed"

if ! $DRY_RUN && [[ -e "$DOTFILES_DIR" ]]; then
    die "$DOTFILES_DIR already exists; remove it first or use a different path"
fi

# --- 3. Clone to a temp directory ---
TMPDIR=$(mktemp -d)
trap cleanup EXIT

echo "Cloning from $REPO_URL"
git clone --bare "$REPO_URL" "$TMPDIR/repo" || die "git clone failed"

# Helper: run git against the temp bare repo with $HOME as work tree
_git() {
    git --git-dir="$TMPDIR/repo" --work-tree="$HOME" "$@"
}

# --- 4. Compare tracked files against $HOME ---
FILES=$(_git ls-tree -r --name-only HEAD)

CONFLICTS=()
EXISTING=()
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    if [[ -e "$HOME/$file" || -L "$HOME/$file" ]]; then
        EXISTING+=("$file")
        if ! diff -q "$HOME/$file" <(_git show "HEAD:$file") >/dev/null 2>&1; then
            CONFLICTS+=("$file")
        fi
    fi
done <<<"$FILES"

# --- 5. Show diffs and prompt ---
if ((${#CONFLICTS[@]})); then
    echo ""
    echo "Conflicting files (${#CONFLICTS[@]}):"
    for file in "${CONFLICTS[@]}"; do
        printf '  %s\n' "$file"
    done

    echo ""
    if $VERBOSE; then
        echo "Diffs (existing <- repo):"
        for file in "${CONFLICTS[@]}"; do
            echo "--- $file ---"
            diff "$HOME/$file" <(_git show "HEAD:$file") || true
            echo ""
        done
    fi

    if $DRY_RUN; then
        echo "Dry run complete. No changes were made."
        exit 0
    fi

    read -p "Backup these files and proceed? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 1
    fi
else
    if $DRY_RUN; then
        echo "No conflicts. Dry run complete."
        exit 0
    fi
fi

# --- 6. Backup all existing files so checkout succeeds ---
if ((${#EXISTING[@]})); then
    BACKUP_DIR="$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$BACKUP_DIR"
    for file in "${EXISTING[@]}"; do
        mkdir -p "$BACKUP_DIR/$(dirname "$file")"
        mv "$HOME/$file" "$BACKUP_DIR/$file"
    done
    echo "Backed up ${#EXISTING[@]} file(s) to $BACKUP_DIR"
    echo ""
fi

# --- 7. Move bare repo and checkout ---
mv "$TMPDIR/repo" "$DOTFILES_DIR"
TMPDIR="" # nothing left to clean up

dotfiles() {
    git --git-dir="$DOTFILES_DIR" --work-tree="$HOME" "$@"
}

dotfiles config --local status.showUntrackedFiles no

echo "Checking out dotfiles..."
if dotfiles checkout; then
    echo "Dotfiles installed successfully."
else
    echo "Checkout failed." >&2
    if [[ -n "${BACKUP_DIR:-}" ]]; then
        echo "Your original files are in $BACKUP_DIR" >&2
    fi
    exit 1
fi
