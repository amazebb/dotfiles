# shellcheck disable=SC2128
# Manage dotfiles with Git bare repo.
typeset -gA _ZD  # Associative array, see below definition for explanation
typeset -ga _ZDF # Tracked folders for dotfiles repo $HOME/.config/dotfiles/config
typeset -ga _ZEX # Path to git binary if normal repo otherise dotfiles

_ZD=(
    [git]=""    # Git binary, default homebrew install on macOS is /opt/homebrew/bin/git
    [repo]=""   # Dotfiles repo, default is $HOME/.dotfiles if no $HOME/.config/dotfiles/repo file found
    [track]=0   # Current folder tracked(1)/not-tracked(0) status, automatically determined
    [prompt]="" # Git status summary to use for prompt
)

_zz_dot_init() {
    _ZD[git]=${_ZD[git]:-$(command -v git)} || {
        echo "dotfiles: git not found in PATH" >&2
        return 1
    }

    local tmp
    tmp=$(head -n1 "$HOME/.config/dotfiles/repo" 2>/dev/null)
    tmp=${tmp/#\~/$HOME}
    tmp=${tmp/\$HOME/$HOME}
    _ZD[repo]=${tmp:-$HOME/.dotfiles}
    if [[ ! -d ${_ZD[repo]} ]]; then
        echo "dotfiles: No $HOME/.dotfiles repo found or defined in file $HOME/.config/dotfiles/repo " >&2
        return 1
    fi

    local config="$HOME/.config/dotfiles/config"
    if [[ ! -f $config ]]; then
        echo "dotfiles: Config file not found at $config" >&2
        return 1
    fi

    if ((!${#_ZDF[@]})); then
        _ZDF=()
        local line
        while IFS= read -r line; do
            [[ -z $line || $line == \#* ]] && continue
            tmp=${line/#\~/$HOME}
            _ZDF+=("${tmp/\$HOME/$HOME}")
        done <"$config"
    fi
}

_zz_dot_is_tracked() {
    _ZD[track]=0
    if [[ $PWD == "${_ZD[repo]:h}" ]]; then
        _ZD[track]=1
    else
        local folder
        for folder in "${_ZDF[@]}"; do
            [[ $PWD == $folder* ]] && _ZD[track]=1 && break
        done
    fi

    _ZEX=("${_ZD[git]}")
    if ((_ZD[track])); then
        local repo
        repo=${_ZD[repo]}
        _ZEX+=("--git-dir=$repo" "--work-tree=${repo:h}")
    fi
}

_zz_dot_status_line() {
    # Get branch name
    _ZD[prompt]=$($_ZEX rev-parse --abbrev-ref HEAD 2>/dev/null)
    [[ -z ${_ZD[prompt]} ]] && return 1

    # Check git status for changes
    local porcelain
    porcelain=$($_ZEX status --porcelain 2>/dev/null)

    if [[ -n $porcelain ]]; then
        local -i s=0
        s=$(echo "$porcelain" | grep -c "^[MTADRC]")
        ((s)) && _ZD[prompt]+=" +$s" # staged
        s=$(echo "$porcelain" | grep -c "^.[MTDRC]")
        ((s)) && _ZD[prompt]+=" ~$s" # unstaged
        s=$(echo "$porcelain" | grep -c "^??")
        ((s)) && _ZD[prompt]+=" ?$s" # untracked
    fi

    echo "${_ZD[prompt]}"
}

_zz_dot_status() {
    $_ZEX "$@"
    local untracked
    untracked=$($_ZEX ls-files --others --exclude-standard "${_ZDF[@]}")
    if [[ -n "$untracked" ]]; then
        printf "\n%s\n%s\n" "Untracked files in tracked folders:" '(use "git add <file>..." to include in what will be committed)'
        echo -e "\033[31m"
        # shellcheck disable=SC2001
        echo "$untracked" | sed 's/^/\t/'
        echo -e "\033[0m"
    fi
}

_zz_dot_track_status() {
    # Returns (1)tracked dotfiles folder, otherwise (0)
    echo ${_ZD[track]}
}

dotfiles() {
    # Initialize on first run or could remove if performance not an issue
    [[ -z ${_ZD[git]} ]] && _zz_dot_init
    _zz_dot_is_tracked

    case $1 in
    stline)
        shift
        _zz_dot_status_line "$@"
        ;;
    track) _zz_dot_track_status ;;
    *)
        if ((_ZD[track])); then
            case $1 in
            status)
                shift
                _zz_dot_status "$@"
                ;;
            clean)
                shift
                "$_ZEX" clean "$@" "${_ZDF[@]}"
                ;;
            *) $_ZEX "$@" ;;
            esac
        else
            git "$@"
        fi
        ;;
    esac
}
