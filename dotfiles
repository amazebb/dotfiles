# shellcheck disable=SC2296
# shellcheck disable=SC2299
#
# Manage dotfiles with Git bare repo.
typeset -ga _ZDF # Absolute paths of folders holding tracked files, built from git ls-files by _zz_dot_init
typeset -ga _ZEX # git command for the current folder: plain git, or git with --git-dir/--work-tree for the dotfiles repo
typeset -g  _ZDL # Last path

# Associative array
typeset -gA _ZD=(
    [repo]="$HOME/.dotfiles"  # Dotfiles repo
    [track]=0                 # Current folder tracked(1)/not-tracked(0) status, automatically determined
    [prompt]=""               # Git status summary to use for prompt
    [gitdir]=""               # Absolute path to repo, .git or .dotfiles, latter same as [repo]
)

_zz_dot_init() {
    emulate -L zsh
    [[ $(command -v git) ]] || { echo "dotfiles: 'git' command not found in PATH" >&2; return 1; }
    [[ -d ${_ZD[repo]} ]] || { echo "dotfiles: No ${_ZD[repo]} repo found" >&2; return 1; }

    local root=${_ZD[repo]:h} dir
    local -a files dirs
    files=("${(@0)$(git -C "$root" --git-dir="${_ZD[repo]}" --work-tree="$root" \
        ls-files -z --full-name --exclude-standard)}")
    files=(${files:#})
    dirs=(${(ou)files:h})

    _ZDF=()
    for dir in $dirs; do
        [[ $dir == . ]] && _ZDF+=$root || _ZDF+="$root/$dir"
    done
    _ZDL=""
}

_zz_dot_is_tracked() {
    emulate -L zsh
    [[ $_ZDL == "$PWD" ]] && return 0
    local folder
    _ZD[track]=0
    _ZD[gitdir]=""
    for folder in "${_ZDF[@]}"; do
        [[ $PWD == "$folder" ]] && _ZD[track]=1 && break
    done
    if ((_ZD[track])); then
        _ZEX=("git" "--git-dir=${_ZD[repo]}" "--work-tree=${_ZD[repo]:h}")
        _ZD[gitdir]=${_ZD[repo]}
    else
        _ZEX=("git")
    fi
    _ZDL=$PWD
}

_zz_dot_status_line() {
    emulate -L zsh
    # One git process: branch from the header, counts from the v2 entries.
    # fsmonitor off so a repo we did not create cannot run its hook;
    # no-optional-locks so the prompt never takes index.lock.
    local -a lines
    lines=("${(@f)$("${_ZEX[@]}" -c core.fsmonitor=false --no-optional-locks \
        status --porcelain=v2 --branch 2>/dev/null)}")

    local head=${lines[(r)\# branch.head *]}
    head=${head#"# branch.head "}
    [[ $head == "(detached)" ]] && head=HEAD
    _ZD[prompt]=$head

    [[ -z $head ]] && return 1
    [[ -z ${_ZD[gitdir]} ]] && _ZD[gitdir]=$("${_ZEX[@]}" rev-parse --absolute-git-dir 2>/dev/null)

    local -i s
    s=${#${(M)lines:#[12]\ [MTADRC]*}}
    ((s)) && _ZD[prompt]+=" +$s" # staged
    s=${#${(M)lines:#[12]\ ?[MTDRC]*}}
    ((s)) && _ZD[prompt]+=" ~$s" # unstaged
    s=${#${(M)lines:#u\ *}}
    ((s)) && _ZD[prompt]+=" !$s" # unmerged (conflicts)
    s=${#${(M)lines:#\?\ *}}
    ((s)) && _ZD[prompt]+=" ?$s" # untracked

    # ahead/behind upstream: "# branch.ab +A -B", present only when an upstream is set
    local ab=${lines[(r)\# branch.ab *]}
    if [[ -n $ab ]]; then
        ab=${ab#"# branch.ab "}
        local -i ahead=${${ab%% *}#+} behind=${${ab##* }#-}
        ((ahead)) && _ZD[prompt]+=" ↑$ahead"
        ((behind)) && _ZD[prompt]+=" ↓$behind"
    fi

    [[ $1 == --print-status ]] && printf "%s\n%s\n%s\n" "${_ZD[prompt]}" "${_ZD[track]}" "${_ZD[gitdir]}"
    return 0
}

dotfiles() {
    emulate -L zsh
    [[ -z $_ZDL ]] && _zz_dot_init
    _zz_dot_is_tracked

    case $1 in
        --zsh-prompt | --print-status)
            _zz_dot_status_line "$@"
            ;;
        *)
            "${_ZEX[@]}" "$@"
            local rc=$?
            _ZDL="" # add, mv, rm, commit... may change the tracked folders: rebuild _ZDF on the next call
            return $rc
            ;;
    esac
}

# First call under autoload runs this file as the function body: forward it.
if (($#)); then
    dotfiles "$@"
fi
